---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Archive & Search — Broadmeadow Brewery"
  description="Browse and search all brewdays, recipes, experiments, competitions, and news."
>
  <div class="outer page-wrap">
    <div class="inner">
      <header class="page-head">
        <h1>Archive &amp; Search</h1>
        <div class="filter-bar">
          <input
            type="search"
            id="journal-search"
            placeholder="Search recipes, hops, malts, or brewdays..."
            aria-label="Search posts"
          />
          <div class="cat-pills" role="tablist">
            <button class="cat-btn active" data-cat="all">All</button>
            <button class="cat-btn" data-cat="brewday">Brewdays</button>
            <button class="cat-btn" data-cat="recipe">Recipes</button>
            <button class="cat-btn" data-cat="experiment">Experiments</button>
            <button class="cat-btn" data-cat="competition">Competitions</button>
            <button class="cat-btn" data-cat="news">News</button>
          </div>
        </div>
      </header>

      <div class="post-feed" id="journal-grid">
        {allPosts.map((post) => <PostCard post={post} />)}
      </div>

      <p id="empty-state" class="empty-msg" hidden>No matching articles found.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const searchInput = document.getElementById('journal-search') as HTMLInputElement;
  const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
  const cards = document.querySelectorAll<HTMLElement>('#journal-grid .post-card');
  const emptyState = document.getElementById('empty-state');

  let activeCat = 'all';
  let searchQuery = '';

  function applyFilters() {
    let visible = 0;
    cards.forEach((card) => {
      const cat = card.dataset.category || '';
      const text = card.dataset.search || '';
      const matchesCat = activeCat === 'all' || cat === activeCat;
      const matchesSearch = !searchQuery || text.includes(searchQuery.toLowerCase());

      if (matchesCat && matchesSearch) {
        card.style.display = 'flex';
        visible++;
      } else {
        card.style.display = 'none';
      }
    });

    if (emptyState) emptyState.hidden = visible > 0;
  }

  const params = new URLSearchParams(window.location.search);
  const urlCat = params.get('category');
  const urlQuery = params.get('q');

  if (urlCat) {
    activeCat = urlCat;
    catButtons.forEach((btn) => btn.classList.toggle('active', btn.dataset.cat === activeCat));
  }
  if (urlQuery && searchInput) {
    searchQuery = urlQuery;
    searchInput.value = urlQuery;
  }
  applyFilters();

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim();
    applyFilters();
  });

  catButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCat = btn.dataset.cat || 'all';
      catButtons.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      applyFilters();
    });
  });
</script>

<style>
  .page-wrap {
    padding-top: 3rem;
  }

  .page-head {
    margin-bottom: 3rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .page-head h1 {
    font-size: clamp(1.85rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }

  .filter-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #journal-search {
    width: 100%;
    max-width: 520px;
    padding: 0.7rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.96rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background-color: var(--bg-soft);
    color: var(--text-main);
  }

  #journal-search:focus {
    outline: 2px solid var(--text-main);
    background-color: #ffffff;
  }

  .cat-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .cat-btn {
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.4rem 0.85rem;
    border-radius: 99px;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-body);
    cursor: pointer;
  }

  .cat-btn.active {
    background-color: var(--text-main);
    border-color: var(--text-main);
    color: #ffffff;
  }

  .post-feed {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem 2.25rem;
  }

  .empty-msg {
    color: var(--text-muted);
    padding: 2rem 0;
  }

  @media (max-width: 900px) {
    .post-feed {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .page-wrap {
      padding-top: 2rem;
    }
    .post-feed {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
