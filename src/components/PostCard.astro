---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_META, withBase } from '../utils/srm';

interface Props {
  post: CollectionEntry<'posts'>;
  large?: boolean;
}

const { post, large = false } = Astro.props;
const {
  title,
  description,
  pubDate,
  category,
  tags,
  beerStyle,
  batchNumber,
  readingTime,
  heroImage,
} = post.data;

const meta = CATEGORY_META[category];
const formattedDate = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<article
  class:list={['post-card', { 'post-card-large': large }]}
  data-category={category}
  data-tags={tags.join(',').toLowerCase()}
  data-search={`${title} ${description} ${beerStyle || ''} ${batchNumber || ''} ${tags.join(' ')}`.toLowerCase()}
>
  {
    heroImage && (
      <a class="post-card-image-link" href={withBase(`/posts/${post.slug}`)}>
        <img
          class="post-card-image"
          src={heroImage}
          alt={title}
          loading={large ? 'eager' : 'lazy'}
        />
      </a>
    )
  }

  <div class="post-card-content">
    <a class="post-card-content-link" href={withBase(`/posts/${post.slug}`)}>
      <header class="post-card-header">
        <span class="primary-tag">{meta.plural}</span>
        <h2 class="post-card-title">{title}</h2>
      </header>
      <div class="post-card-excerpt">{description}</div>
    </a>

    <footer class="post-card-meta">
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      {readingTime && <span class="meta-sep">&bull;</span>}
      {readingTime && <span>{readingTime}</span>}
    </footer>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: transparent;
  }

  .post-card-image-link {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    margin-bottom: 1.25rem;
    aspect-ratio: 16 / 10;
    background-color: var(--bg-soft);
  }

  .post-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .post-card:hover .post-card-image {
    transform: scale(1.02);
  }

  .post-card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
  }

  .post-card-content-link {
    display: block;
  }

  .post-card-title {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-main);
    margin-bottom: 0.65rem;
  }

  .post-card:hover .post-card-title {
    opacity: 0.8;
  }

  .post-card-excerpt {
    font-size: 0.98rem;
    line-height: 1.6;
    color: var(--text-body);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card-meta {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  /* Large First Featured Card (Humebrew Desktop Split) */
  @media (min-width: 900px) {
    .post-card-large {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.65fr 1fr;
      gap: 2.5rem;
      align-items: center;
      margin-bottom: 1.25rem;
    }

    .post-card-large .post-card-image-link {
      margin-bottom: 0;
    }

    .post-card-large .post-card-title {
      font-size: 2rem;
    }
  }
</style>
