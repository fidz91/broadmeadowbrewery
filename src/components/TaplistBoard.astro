---
import { ACTIVE_TAPS, ACTIVE_FERMENTERS } from '../data/taplist';
import { srmToHex, withBase } from '../utils/srm';
---

<section class="cellar-strip" aria-label="Currently On Tap and Fermenting">
  <div class="cellar-row">
    <span class="cellar-label">On Tap:</span>
    <div class="cellar-items">
      {
        ACTIVE_TAPS.map((tap) => (
          <a href={tap.postSlug ? withBase(`/posts/${tap.postSlug}`) : '#'} class="cellar-item">
            <span class="srm-dot" style={`background-color: ${srmToHex(tap.srm)};`} />
            <strong>{tap.name}</strong>
            <span class="cellar-meta">({tap.style}, {tap.abv.toFixed(1)}%)</span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="cellar-row">
    <span class="cellar-label">Fermenting:</span>
    <div class="cellar-items">
      {
        ACTIVE_FERMENTERS.map((fv) => (
          <a href={fv.postSlug ? withBase(`/posts/${fv.postSlug}`) : '#'} class="cellar-item">
            <span class="srm-dot" style={`background-color: ${srmToHex(fv.srm)};`} />
            <strong>{fv.name}</strong>
            <span class="cellar-meta">({fv.stage} &bull; {fv.currentGravity.toFixed(3)} SG)</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cellar-strip {
    border-bottom: 1px solid var(--border);
    padding: 1rem 0;
    margin-bottom: 3rem;
    font-size: 0.88rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cellar-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cellar-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    min-width: 90px;
  }

  .cellar-items {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .cellar-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-body);
  }

  .cellar-item:hover {
    opacity: 0.7;
  }

  .cellar-meta {
    color: var(--text-muted);
    font-size: 0.83rem;
  }

  @media (max-width: 640px) {
    .cellar-strip {
      margin-bottom: 2rem;
    }
    .cellar-row {
      flex-direction: column;
      gap: 0.35rem;
    }
    .cellar-items {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.4rem;
    }
  }
</style>
